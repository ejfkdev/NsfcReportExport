{
  "compilerOptions": {
    "target": "ES2022",
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["chrome-types"],
    "allowJs": true
  },
  "include": ["src", "src/**/*.d.ts", "rspack.config.ts"],
  "exclude": ["**/node_modules"]
}
