{
    "update_url": "https://clients2.google.com/service/update2/crx",
    "manifest_version": 3,
    "name": "国自然结题报告下载",
    "description": "国自然结题报告一键导出原图 PDF，自动识别验证码，支持批量、断点续传与失败重试",
    "version": "1.7.3",
    "minimum_chrome_version": "116",
    "key": "",
    "icons": {
        "512": "images/logo.png"
    },
    "action": {
        "icons": {
            "512": "images/logo.png"
        },
        "default_title": "打开报告下载管理页"
    },
    "background": {
        "service_worker": "service_worker.js"
    },
    "externally_connectable": {
        "matches": ["https://kd.nsfc.cn/*"],
        "accepts_tls_channel_id": true
    },
    "content_scripts": [
        {
            "matches": ["https://kd.nsfc.cn/finalDetails*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "host_permissions": [
        "https://kd.nsfc.cn/*",
        "https://*.sogoucdn.com/*",
        "https://img.noobzone.ru/*",
        "https://*.wp.com/*",
        "https://wsrv.nl/*",
        "https://trace.moe/*",
        "https://99z.top/*",
        "https://down.npee.cn/*",
        "https://get.2sb.org/*",
        "https://cdn.cdnjson.com/*",
        "https://cors.zme.ink/*",
        "https://images.weserv.nl/*"
    ],
    "permissions": [
        "downloads",
        "notifications",
        "contextMenus",
        "alarms",
        "storage",
        "unlimitedStorage"
    ]
}