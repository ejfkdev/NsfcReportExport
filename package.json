{
  "name": "NsfcReportExport",
  "version": "1.7.3",
  "author": {
    "name": "ejfkdev"
  },
  "homepage": "https://github.com/ejfkdev/NsfcReportExport",
  "scripts": {
    "reset": "npx rimraf ./**/node_modules",
    "prepare": "husky install",
    "build": "NODE_ENV=production rspack build",
    "package": "pnpm run build && node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "node --max_old_space_size=8192 ./node_modules/eslint/bin/eslint.js --fix --color --cache --quiet"
    ]
  },
  "eslintIgnore": [
    "node_modules/",
    "dist/"
  ],
  "dependencies": {
    "image-dimensions": "^2.6.0",
    "jspdf": "^4.2.1",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@rspack/cli": "2.3.4",
    "@rspack/core": "2.3.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "~26.6.11",
    "chrome-types": "^0.1.465",
    "husky": "~9.1.7",
    "lint-staged": "~17.6.2",
    "prettier": "~3.10.1",
    "rimraf": "~6.1.4",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2"
  }
}
